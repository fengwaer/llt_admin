{{extend 'public/layout' }}
 {{block 'content'}}
 <style>
    .box_1 .in{ margin-right:10px;}
    .win .p{ margin-bottom:10px;}
    .bt3{ margin-right:10px;}
    .fn_1{ width:110px;}
    .c3{ text-align:center; font-size: 12px;}
 </style>
<link href="/public/cs/quill.snow.css" rel="stylesheet">
 <div class="box mdgl" id="app" v-clock>
    <div class="fn"><i class="bt2" @click="win.data={type:'',date:''},win.is=1">添加</i>
        <input v-model='sch.sch' class="in" type="text"  placeholder="输入..." @keyup.enter='sch.page=0;sch.more=1;get()'>
        <i class="bt1 sch" @click='sch.page=0;sch.more=1;get()'>搜索</i> 
        <select class="bt4" @change='get();' v-model="sch.type">
            <option v-for='t of type' v-text='t.type' :value="t.type"></option>
        </select>
        <b v-text='data.length'></b>
    </div>
    <div class="xdbj">
        <div class="li" v-for="dt of data">
            <p class="ti" v-text="dt.type" @click="del(dt.id)"></p>
            <div class="txt" v-html="dt.txt" @click="win.data=dt,win.is=1"></div>
        </div>
    </div>

<div class="win" v-if="win.is">
    <div class="box_1"><i class="close" @click="win.is=false">Ⅹ</i>
    <div class='box_2 p_slt'>
        <div class="p"><b>类型：</b><input type="text" class="in" v-model="win.data.type" @focus="p_slt.is=1" @blur="setTimeout(()=>{p_slt.is=0},150)"></div>
            <ul class="ul" v-show="p_slt.is">
                <li v-for='t of type' :value="t.type" v-text="t.type" @click="win.data.type=t.type"></li>
            </ul>
            <div v-if="win.is" ref="editor"></div>
    </div>
    
        
    </div>
    <p><i class="bt1" @click="add()">提交</i></p>
    </div>
</div>

</div>
<script src="/public/js/quill.js"></script>
<script type="text/javascript">
        $(document).ready(e=>{
            $('.in').keydown(function(e){if(e.keyCode==32){return false}});//禁止输入空格 
            $('.table').on('scroll',function(){
                if ($(this).find('table').height()-$(this).scrollTop()<820){
                    app.get();
                }
            });
        })
var app = new Vue({
    el: '#app',
    data: {
        win:{is:0,data:{date:'',type:''}},
        p_slt:{is:0},
        sch:{num:50,page:0,sch:'',type:'',more:1},
        type:[],
        data:[],
        date_ps:1,
        quill: null,
    },
    created(){
        window.addEventListener('keyup', this.keyup);
        this.get();
    },
    watch: {
        // 只要弹窗打开，就立即安全初始化 Quill
        'win.is'(newVal) {
            if (newVal) {
                this.$nextTick(() => {
                    // 防止重复初始化
                    if (this.quill) {
                        this.quill = null; // 先销毁旧实例（可选）
                        this.$refs.editor.innerHTML = ''; // 清空容器
                    }
                    // 此时 ref="editor" 的 DOM 100% 已经渲染好了
                    if (!this.quill) {
                        this.quill = new Quill(this.$refs.editor, {
                            theme: 'snow',
                            modules: {
                                toolbar: [
                                    ['bold', 'italic', 'underline'],
                                    [{ 'color': [] }],
                                    [{ 'size': [] }]
                                ]
                            }
                        });

                        // 如果是编辑状态，回填内容
                        if (this.win.data.txt) {
                            this.quill.root.innerHTML = this.win.data.txt;
                        }

                        // 可选：监听内容变化，实时同步到 win.data.txt
                        this.quill.on('text-change', () => {
                            this.win.data.txt = this.quill.root.innerHTML;
                        });
                    }
                });
            }
        }
    },
    methods:{
          get:function(id){//获取数据
            let _this=this;
            $.ajax({url:'/xdbj',data:{get:1,...this.sch},success:function(res){
                _this.data=res.data[1];
                _this.type=[{id:-1,type:null},...res.data[0]];
            }})
        },
        add:function(){//添加或修改
           // 确保最新内容已同步
        if (this.quill) {
            this.win.data.txt = this.quill.root.innerHTML;
        }

        // 然后再发请求...
        let get = this.win.data.id ? 3 : 2;
        $.ajax({
            url: '/xdbj',
            data: { get, ...this.win.data },
            success: (res) => {
                this.win.is = 0;
                ctl.tips_show(res.code == 0 ? '操作失败！' : '操作成功！');
                if (res.code != 0) setTimeout(() => this.get(), 500);
            }
        });
        },
        del:function(id){//删除
            let _this=this;
            this.win.is=0;
            if(confirm('警告！确定要删除该笔记吗？')){
                $.ajax({url:'/xdbj',data:{get:0,id:id},success:function(res){
                    if(res.code==0){ctl.tips_show(res.msg)}
                    else{ctl.tips_show(res.msg);
                        setTimeout((e)=>{_this.get();},500)
                    }
                }})
            }
        },
        keyup(e){
          if(e.key=='Escape'){this.win.is=0;}
        },
        
    }
})
        
    </script>
{{/block}}