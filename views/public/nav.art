<div class="nav">
<a class='come' >欢迎：</a>
<a href="/case"><i class="ift ift-gl"></i><span> 案件管理</span></a>
<a href="/tj"><i class="ift ift-gail"></i><span> 系统概览</span></a>
 <a href="/wait"><i class="ift ift-db"></i><span> 待办事项</span><i id="wait"></i></a>
 <a id="user" href="/xdbj"><i class="ift ift-bj"></i><span> 心得笔记</span></a>
<a class="pc" href="/zlsj">资料收集</a>
<a class="pc" href="/pic">PDF与图片</a>
<!-- <a id="user" href="/user/index">用户管理</a> -->
<a href="/login?out=1" class="out">退出</a> 
</div>
 <script type="text/javascript">
    $(document).ready(e=>{
        if(JSON.parse(localStorage.getItem('user')))
        $('.come').html(JSON.parse(localStorage.getItem('user')).names)
        if(JSON.parse(localStorage.getItem('user')).Id>1){$('#user').hide();}
        $('.nav a ').each(function(i,e){
            if(location.href.indexOf($(e).attr('href'))!=-1){
                $(e).addClass('on')
                return false;
            }
        })
        if(!$('.nav').is(':hidden')){
            // if(Notification.permission !== "granted"){ctl.ask.is=1}
            ctl.get().then(res=>{
                if(res>0){$('#wait').html(res);}
                else{$('#wait').hide();}
                
            });
        }
        
    })
    $('.come').click(()=>{
        if($('.nav').hasClass('open')){$('.nav').removeClass('open');}
        else{$('.nav').addClass('open');}
    })
    $('.nav a').click(function(){
        if($(this).attr('href')!='/')
        if(location.href.indexOf($(this).attr('href'))!=-1){return false;}
    })
    // $('.out').click(function(){
    //      $.ajax({url:'/login',data:{out:1},success:function(res){
    //             ctl.tips_show(res.msg);
    //         }})
    // })
</script>